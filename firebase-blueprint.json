{
  "entities": {
    "Article": {
      "title": "Article",
      "description": "A generated SEO-optimized article with metadata",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Owner user ID" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "html_content": { "type": "object" },
        "schema_markup": { "type": "object" },
        "seo_metadata": { "type": "object" },
        "geo_optimization": { "type": "object" },
        "social_posts": { "type": "array" },
        "htmlContent": { "type": "string" },
        "seoChecklist": { "type": "array" },
        "readability": { "type": "array" },
        "groundingSources": { "type": "array" },
        "originalArticleText": { "type": "string" }
      },
      "required": ["uid", "createdAt", "htmlContent"]
    },
    "PipelineJob": {
      "title": "PipelineJob",
      "description": "A job in the article generation pipeline",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "brief": { "type": "string" },
        "html": { "type": "string" },
        "imageUrl": { "type": "string" },
        "imageMetadata": { "type": "object" },
        "status": { "type": "string", "enum": ["brief_ready", "article_ready", "done", "error"] },
        "userId": { "type": "string" },
        "error": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["status", "title", "brief"]
    }
  },
  "firestore": {
    "/articles/{articleId}": {
      "schema": "Article",
      "description": "Collection of generated articles"
    },
    "/pipeline/{jobId}": {
      "schema": "PipelineJob",
      "description": "Jobs for the article generation pipeline"
    }
  }
}
